# Raw FISS .xls downloads: regenerable from data/<wsg>/fiss_xls_manifest.csv via scripts/0210
data/*/fiss_xls/
# Harvested report PDFs go to Zotero (scripts/0153), never to git
**/*.pdf
# Ragnar stores live in s3://fresh-bc/rag/ via cred::crd_store_push(); local copies are caches
data/rag/
*.duckdb
*.bak
.DS_Store
.Rproj.user
.Rhistory
# FISS run-log debris: retries and aborted attempts (scripts/logs/fiss/README.md)
scripts/logs/fiss/runs/
# FDIS export cache: source of truth is s3://fresh-bc/fdis/ (scripts/0230 syncs it)
data/fdis/

# Local cache of public EcoCat/ACAT report PDFs (with .url and pdftotext .txt sidecars) per watershed group.
# Re-fetchable from the report id (a100.gov.bc.ca/pub/acat/documents/r<id>/); no script reads it.
data/*/reports_pdf/
# pkgdown site, built by .github/workflows/pkgdown.yaml
docs/
# Tuning run (scripts/0320): the per-segment grade tables and fitted curves are large; 0325 publishes the grades
data/tune/*_grades.csv
data/tune/curves.rds
data/tune/*_score.rds
data/tune/*_curve.rds
# Comparison (scripts/0330): the catalog's floodplain GeoPackages are a cache; the interactive maps are local
data/compare/catalog/
data/compare/maps/
data/compare/*_segments.rds
# Published Parquet sets (scripts/0325): the manifest and bucket are the record
data/publish/
